# Auth — agent's fork (push access)
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
FORK_URL=github.com/your-agent-user/mars-mission-fund
GIT_USER_NAME=mmf-agent
GIT_USER_EMAIL=agent@marsmissionfund.com

# Auth — upstream repo (read issues, create PRs)
UPSTREAM_REPO=LeeCampbell/mars-mission-fund
GH_TOKEN_UPSTREAM=ghp_xxxxxxxxxxxxxxxxxxxx

# Claude auth
CLAUDE_CODE_OAUTH_TOKEN=your-oauth-token

# Milestone (set by run.sh, or override manually)
# MILESTONE_NUMBER=1

# Tuning
MAX_ITERATIONS=30
COOLDOWN_SECONDS=3
TIMEOUT_SECONDS=1800
UPSTREAM_BASE_BRANCH=main
